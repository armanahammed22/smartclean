{
  "entities": {
    "LandingPage": {
      "title": "LandingPage",
      "description": "Configuration for a dynamic product or service landing page.",
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "type": { "type": "string", "enum": ["product", "service"] },
        "title": { "type": "string" },
        "active": { "type": "boolean" },
        "bannerImage": { "type": "string" },
        "productIds": { "type": "array" },
        "packages": { "type": "array" },
        "addOns": { "type": "array" }
      }
    },
    "EmployeeProfile": {
      "title": "EmployeeProfile",
      "description": "Detailed staff information and salary model configuration.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "salaryModel": { "type": "string", "enum": ["daily", "monthly", "hybrid"] },
        "baseRate": { "type": "number" },
        "commissionRate": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "skills": { "type": "array" }
      }
    },
    "AdvancedOffer": {
      "title": "AdvancedOffer",
      "description": "Sophisticated marketing campaign configuration including BOGO and bundles.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["buy_x_get_y", "bundle", "min_order", "tiered"] },
        "isActive": { "type": "boolean" },
        "targeting": { "type": "string" },
        "rules": { "type": "object" },
        "createdAt": { "type": "string" }
      }
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily clock-in and clock-out logs with GPS data.",
      "type": "object",
      "properties": {
        "staffId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "checkIn": { "type": "string", "format": "date-time" },
        "checkOut": { "type": "string", "format": "date-time" },
        "location": { "type": "object" },
        "status": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/landing_pages/{id}": { "schema": "LandingPage", "description": "Dynamic landing pages." },
    "/employee_profiles/{id}": { "schema": "EmployeeProfile", "description": "Staff profiles." },
    "/attendance_logs/{id}": { "schema": "Attendance", "description": "Attendance tracking." },
    "/advanced_offers/{id}": { "schema": "AdvancedOffer", "description": "Marketing engine rules." },
    "/expense_claims/{id}": { "schema": "object", "description": "Staff reimbursement claims." }
  }
}