
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Auth Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Comprehensive Admin Check
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'Q8QpZP1GzzWf2f2K6WTe476PcD92' ||
        request.auth.uid == 'uZAUBd4L5veqdxk4H6QvKz4Ddgf2' ||
        request.auth.token.email == 'smartclean422@gmail.com' ||
        exists(/databases/$(database)/documents/roles_admins/$(request.auth.uid))
      );
    }

    // 🛡️ GLOBAL ADMIN OVERRIDE
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // 🌍 PUBLIC ACCESS (Read for everyone, Write for Admin)
    match /categories/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /subcategories/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /childcategories/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /master_attributes/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /products/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /services/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /service_packages/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /sub_services/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /advanced_offers/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /smart_pricing_rules/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /brands/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /reusable_features/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /reusable_specs/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /variant_types/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /service_areas/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /subscription_plans/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /site_settings/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /hero_banners/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /offers/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /marketing_offers/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /top_nav_categories/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /homepage_sections/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /custom_grid_modules/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /pages_management/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /landing_pages/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /quick_actions/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /quick_links/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /campaigns/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /invoices/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /coupons/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /delivery_options/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /cleaning_projects/{document=**} { allow read, write: if isAdmin(); }
    match /work_entries/{document=**} { allow read, write: if isAdmin(); }

    // 🔒 USER/STAFF SPECIFIC (Requires Auth)
    match /users/{uid} { allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin()); }
    match /roles_admins/{uid} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /roles_employees/{uid} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    
    match /bookings/{id} { 
      allow create: if true; 
      allow read: if isAdmin() || (isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.assignedEmployees.exists(e, e.uid == request.auth.uid))); 
      allow update: if isAdmin() || (isSignedIn() && (resource.data.teamLeaderId == request.auth.uid || resource.data.assignedEmployees.exists(e, e.uid == request.auth.uid)));
    }

    match /orders/{id} {
      allow create: if true;
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
    }

    // HRM & Field Operations
    match /employee_profiles/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /payroll_records/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /attendance_logs/{id} { allow read: if isSignedIn(); allow write: if isSignedIn(); }
    match /leave_requests/{id} { 
      allow create: if isSignedIn(); 
      allow read: if isSignedIn() && (resource.data.staffId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }
    match /expense_claims/{id} { 
      allow create: if isSignedIn(); 
      allow read: if isSignedIn() && (resource.data.staffId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }
    match /staff_earnings/{id} { allow read: if isSignedIn() && (resource.data.staffId == request.auth.uid || isAdmin()); allow write: if isAdmin(); }
    match /staff_availability/{id} { allow read: if isSignedIn(); allow write: if isSignedIn() && (request.auth.uid == id || isAdmin()); }
    
    // CRM
    match /leads/{id} { allow read, write: if isAdmin(); }
    match /custom_requests/{id} { 
      allow create: if true; 
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid); 
      allow update: if isAdmin(); 
    }
    
    // Finance
    match /finance_ledger/{id} { allow read, write: if isAdmin(); }
    match /finance_accounts/{id} { allow read, write: if isAdmin(); }
    match /finance_staff_salaries/{id} { allow read, write: if isAdmin(); }
    match /partner_projects/{id} { allow read, write: if isAdmin(); }
    
    // Partners & Vendors
    match /partners/{id} { allow read, write: if isAdmin(); }
    match /vendor_profiles/{id} { allow read: if true; allow write: if isAdmin(); }
    match /couriers/{id} { allow read, write: if isAdmin(); }
    
    // Tracking & Analytics
    match /tracking_logs/{id} { allow create: if true; allow read, write: if isAdmin(); }
    match /live_locations/{id} { allow read: if true; allow write: if isSignedIn(); }
  }
}
