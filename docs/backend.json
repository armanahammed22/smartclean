
{
  "entities": {
    "CleaningProject": {
      "title": "CleaningProject",
      "description": "Master project configuration for cleaning contracts.",
      "type": "object",
      "properties": {
        "clientName": { "type": "string" },
        "location": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "totalArea": { "type": "number", "description": "Total area in Square Feet" },
        "status": { "type": "string", "enum": ["Active", "Completed", "On Hold"] },
        "supervisorId": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "WorkEntry": {
      "title": "WorkEntry",
      "description": "Daily work log entry for a specific project.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "date": { "type": "string" },
        "workType": { "type": "string", "enum": ["Floor Cleaning", "Glass Cleaning", "Sofa Cleaning", "Deep Cleaning", "Toilet Cleaning", "Carpet Cleaning", "Other"] },
        "quantity": { "type": "number" },
        "unitType": { "type": "string", "enum": ["Square Feet", "Pieces", "KG", "Feet", "Meter"] },
        "workers": { "type": "array" },
        "notes": { "type": "string" }
      }
    },
    "ServicePackage": {
      "title": "ServicePackage",
      "description": "A bundle of multiple services sold at a fixed price.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "price": { "type": "number" },
        "regularPrice": { "type": "number" },
        "serviceIds": { "type": "array", "description": "List of IDs from services collection" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "imageUrl": { "type": "string" }
      }
    },
    "LandingPage": {
      "title": "LandingPage",
      "description": "Configuration for a dynamic product or service landing page.",
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "type": { "type": "string", "enum": ["product", "service"] },
        "title": { "type": "string" },
        "active": { "type": "boolean" },
        "bannerImage": { "type": "string" },
        "productIds": { "type": "array" },
        "packages": { "type": "array" },
        "addOns": { "type": "array" }
      }
    },
    "EmployeeProfile": {
      "title": "EmployeeProfile",
      "description": "Detailed staff information and salary model configuration.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "salaryModel": { "type": "string", "enum": ["daily", "monthly", "hybrid"] },
        "baseRate": { "type": "number" },
        "commissionRate": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Inactive", "On Leave", "Suspended"] },
        "skills": { "type": "array" }
      }
    },
    "CustomGridModule": {
      "title": "CustomGridModule",
      "description": "A reusable grid block containing multiple customizable cards and design settings.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "items": { 
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "sourceType": { "type": "string", "enum": ["manual", "product", "service", "sub_service"] },
              "sourceId": { "type": "string" },
              "title": { "type": "string" },
              "desc": { "type": "string" },
              "price": { "type": "string" },
              "imageUrl": { "type": "string" },
              "btnText": { "type": "string" },
              "btnLink": { "type": "string" },
              "badge": { "type": "string" },
              "isActive": { "type": "boolean" }
            }
          }
        },
        "styleConfig": { "type": "object" },
        "createdAt": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/cleaning_projects/{id}": { "schema": "CleaningProject", "description": "Main projects." },
    "/work_entries/{id}": { "schema": "WorkEntry", "description": "Daily logs." },
    "/service_packages/{id}": { "schema": "ServicePackage", "description": "Bundled service deals." },
    "/landing_pages/{id}": { "schema": "LandingPage", "description": "Dynamic landing pages." },
    "/employee_profiles/{id}": { "schema": "EmployeeProfile", "description": "Staff profiles." },
    "/custom_grid_modules/{id}": { "schema": "CustomGridModule", "description": "Reusable grid layouts." },
    "/homepage_sections/{id}": { "schema": "object", "description": "Homepage layout sequence." },
    "/hero_banners/{id}": { "schema": "object", "description": "Homepage slider assets." }
  }
}
