
{
  "entities": {
    "LandingPage": {
      "title": "LandingPage",
      "description": "Configuration for a dynamic product or service landing page.",
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "type": { "type": "string", "enum": ["product", "service"] },
        "title": { "type": "string" },
        "active": { "type": "boolean" },
        "bannerImage": { "type": "string" },
        "productIds": { "type": "array" },
        "packages": { "type": "array" },
        "addOns": { "type": "array" }
      }
    },
    "EmployeeProfile": {
      "title": "EmployeeProfile",
      "description": "Detailed staff information and salary model configuration.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "salaryModel": { "type": "string", "enum": ["daily", "monthly", "hybrid"] },
        "baseRate": { "type": "number" },
        "commissionRate": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "skills": { "type": "array" }
      }
    },
    "AdvancedOffer": {
      "title": "AdvancedOffer",
      "description": "Sophisticated marketing campaign configuration including BOGO and bundles.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["buy_x_get_y", "bundle", "min_order", "tiered"] },
        "status": { "type": "string", "enum": ["Draft", "Live", "Scheduled", "Expired"] },
        "targeting": { "type": "string" },
        "rules": { "type": "object" },
        "applicableItems": { "type": "array" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string" }
      }
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily clock-in and clock-out logs with GPS data.",
      "type": "object",
      "properties": {
        "staffId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "checkIn": { "type": "string", "format": "date-time" },
        "checkOut": { "type": "string", "format": "date-time" },
        "location": { "type": "object" },
        "status": { "type": "string" }
      }
    },
    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "Financial transaction log for income and expenses.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "paidStatus": { "type": "string", "enum": ["Paid", "Unpaid"] },
        "date": { "type": "string", "format": "date-time" },
        "accountId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/landing_pages/{id}": { "schema": "LandingPage", "description": "Dynamic landing pages." },
    "/employee_profiles/{id}": { "schema": "EmployeeProfile", "description": "Staff profiles." },
    "/attendance_logs/{id}": { "schema": "Attendance", "description": "Attendance tracking." },
    "/advanced_offers/{id}": { "schema": "AdvancedOffer", "description": "Marketing engine rules." },
    "/finance_ledger/{id}": { "schema": "LedgerEntry", "description": "Central accounting log." },
    "/hero_banners/{id}": { "schema": "object", "description": "Homepage slider assets." }
  }
}
