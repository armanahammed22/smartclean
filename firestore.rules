rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Auth Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Comprehensive Admin Check
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'Q8QpZP1GzzWf2f2K6WTe476PcD92' ||
        request.auth.uid == 'uZAUBd4L5veqdxk4H6QvKz4Ddgf2' ||
        request.auth.token.email == 'smartclean422@gmail.com' ||
        exists(/databases/$(database)/documents/roles_admins/$(request.auth.uid))
      );
    }

    // Team Leader Check for live location
    function isTeamLeader(bookingId) {
      return isSignedIn() && get(/databases/$(database)/documents/bookings/$(bookingId)).data.teamLeaderId == request.auth.uid;
    }

    // 🛡️ GLOBAL ADMIN OVERRIDE
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Finance & Accounts
    match /finance_ledger/{id} { allow read, write: if isAdmin(); }
    match /finance_accounts/{id} { allow read, write: if isAdmin(); }
    match /finance_staff_salaries/{id} { allow read, write: if isAdmin(); }
    match /finance_staff_earnings/{id} { allow read, write: if isAdmin(); }
    
    // Partners & B2B
    match /partners/{id} { allow read, write: if isAdmin(); }
    match /partner_projects/{id} { allow read, write: if isAdmin(); }
    
    // Vendors
    match /vendor_profiles/{id} { 
      allow read: if true; 
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == id); 
    }
    match /blocked_users/{id} { allow read, write: if isAdmin(); }

    // Taxonomy & Attributes
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /subcategories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /childcategories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /brands/{id} { allow read: if true; allow write: if isAdmin(); }
    match /variant_types/{id} { allow read: if true; allow write: if isAdmin(); }
    match /reusable_features/{id} { allow read: if true; allow write: if isAdmin(); }
    match /reusable_specs/{id} { allow read: if true; allow write: if isAdmin(); }

    // Support
    match /support_tickets/{id} { 
      allow create: if isSignedIn(); 
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Tracking & Marketing
    match /tracking_logs/{id} { allow read, write: if isAdmin(); }
    match /live_locations/{bookingId} {
      allow read: if true; 
      allow write: if isTeamLeader(bookingId) || isAdmin();
    }

    match /site_settings/{id} { allow read: if true; allow write: if isAdmin(); }

    // Public Collections
    match /products/{id} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    
    match /product_qna/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    
    match /services/{id} { 
      allow read: if true; 
      allow write: if isAdmin(); 
      match /packages/{pId} { allow read: if true; allow write: if isAdmin(); }
      match /addOns/{aId} { allow read: if true; allow write: if isAdmin(); }
      match /includedItems/{iId} { allow read: if true; allow write: if isAdmin(); }
      match /reviews/{rId} { 
        allow read: if true; 
        allow create: if isSignedIn(); 
        allow update, delete: if isAdmin(); 
      }
    }
    
    match /sub_services/{id} { 
      allow read: if true; 
      allow write: if isAdmin(); 
      match /packages/{pId} { allow read: if true; allow write: if isAdmin(); }
      match /reviews/{rId} { 
        allow read: if true; 
        allow create: if isSignedIn(); 
        allow update, delete: if isAdmin(); 
      }
    }

    match /smart_pricing_rules/{id} { allow read: if true; allow write: if isAdmin(); }
    match /coupons/{id} { allow read: if true; allow write: if isAdmin(); }
    match /campaigns/{id} { 
      allow read: if true; allow write: if isAdmin(); 
      match /products/{pId} { allow read: if true; allow write: if isAdmin(); }
    }
    match /advanced_offers/{id} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    
    // UI & Layout
    match /homepage_sections/{id} { allow read: if true; allow write: if isAdmin(); }
    match /hero_banners/{id} { allow read: if true; allow write: if isAdmin(); }
    match /top_nav_categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /quick_links/{id} { allow read: if true; allow write: if isAdmin(); }
    match /quick_actions/{id} { allow read: if true; allow write: if isAdmin(); }
    match /delivery_options/{id} { allow read: if true; allow write: if isAdmin(); }
    match /payment_methods/{id} { allow read: if true; allow write: if isAdmin(); }
    match /marketing_offers/{id} { allow read: if true; allow write: if isAdmin(); }
    match /pages_management/{id} { allow read: if true; allow write: if isAdmin(); }
    match /offers/{id} { allow read: if true; allow write: if isAdmin(); }
    match /landing_pages/{id} { allow read: if true; allow write: if isAdmin(); }
    match /subscription_plans/{id} { allow read: if true; allow write: if isAdmin(); }

    match /bookings/{id} { 
      allow create: if true; 
      allow read: if isAdmin() || (isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.assignedEmployees.exists(e, e.uid == request.auth.uid))); 
      allow update: if isAdmin() || (isSignedIn() && resource.data.teamLeaderId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /orders/{id} {
      allow create: if true;
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /leads/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /custom_requests/{id} {
      allow create: if true;
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /employee_profiles/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /staff_availability/{id} { allow read: if true; allow write: if isSignedIn() && (request.auth.uid == id || isAdmin()); }
    match /staff_earnings/{id} { allow read: if isAdmin() || (isSignedIn() && resource.data.staffId == request.auth.uid); allow write: if isAdmin(); }
    match /expense_claims/{id} { 
      allow create: if isSignedIn(); 
      allow read: if isAdmin() || (isSignedIn() && resource.data.staffId == request.auth.uid);
      allow write: if isAdmin();
    }
    
    match /invoices/{id} { allow read: if true; allow write: if isAdmin(); }
    match /invoiceRequests/{id} { allow create: if isSignedIn(); allow read, write: if isAdmin(); }
    
    match /roles_admins/{uid} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /roles_employees/{uid} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /roles_management/{id} { allow read, write: if isAdmin(); }
    match /users/{uid} { allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin()); }
    
    match /couriers/{id} { allow read, write: if isAdmin(); }
    match /referrals/{id} { 
      allow read: if isAdmin() || (isSignedIn() && resource.data.referrerId == request.auth.uid);
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}