
{
  "entities": {
    "LandingPage": {
      "title": "LandingPage",
      "description": "Configuration for a dynamic product or service landing page.",
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "type": { "type": "string", "enum": ["product", "service"] },
        "title": { "type": "string" },
        "active": { "type": "boolean" },
        "bannerImage": { "type": "string" },
        "productIds": { "type": "array" },
        "packages": { "type": "array" },
        "addOns": { "type": "array" }
      }
    },
    "EmployeeProfile": {
      "title": "EmployeeProfile",
      "description": "Detailed staff information and salary model configuration.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "salaryModel": { "type": "string", "enum": ["daily", "monthly", "hybrid"] },
        "baseRate": { "type": "number" },
        "commissionRate": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Inactive", "On Leave", "Suspended"] },
        "skills": { "type": "array" }
      }
    },
    "CustomGridModule": {
      "title": "CustomGridModule",
      "description": "A reusable grid block containing multiple customizable cards and design settings.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "items": { "type": "array" },
        "styleConfig": { "type": "object" },
        "createdAt": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/landing_pages/{id}": { "schema": "LandingPage", "description": "Dynamic landing pages." },
    "/employee_profiles/{id}": { "schema": "EmployeeProfile", "description": "Staff profiles." },
    "/custom_grid_modules/{id}": { "schema": "CustomGridModule", "description": "Reusable grid layouts." },
    "/homepage_sections/{id}": { "schema": "object", "description": "Homepage layout sequence." },
    "/hero_banners/{id}": { "schema": "object", "description": "Homepage slider assets." }
  }
}
